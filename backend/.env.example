PORT=5000
# Required in production: set a random secret of at least 32 characters.
JWT_SECRET=
CORS_ORIGIN=https://invoxa-lime.vercel.app,http://localhost:5173
NODE_ENV=production

# Optional production bootstrap for the platform admin account.
# Set both values together; the password must be at least 12 characters.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# MongoDB Atlas Connection URI
MONGODB_URI=your_mongodb_connection_string_here

# Optional: path on a persistent mounted disk when not using MongoDB.
# INVOXA_DATA_FILE=/data/invoxa/database.json

# Transactional email (HTTPS API; works on Render Free)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=your_verified_sender_address

# Optional Gmail SMTP fallback (SMTP ports are blocked on Render Free services)
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
